{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "declaration": true,
    "esModuleInterop": true,
    "incremental": true,
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "preserveWatchOutput": true,
    "resolveJsonModule": true,
    "outDir": "./lib",
    "rootDir": "..",
    "strict": false,
    "strictNullChecks": false,
    "baseUrl": "./",
    "paths": {
      "@webio/webio": ["../packages/webio/src/index.ts"]
    },
    "target": "es2017",
    "types": [],
    "ignoreDeprecations": "5.0",
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "skipLibCheck": true
  },
  "include": ["webio-jupyter-labextension/*", "../packages/webio/src/**/*"]
}
